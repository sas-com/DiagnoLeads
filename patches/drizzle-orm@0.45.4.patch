@@ -34,10 +34,11 @@ class DrizzleError extends Error {
 }
 class DrizzleQueryError extends Error {
   constructor(query, params, cause) {
-    super(`Failed query: ${query}
-params: ${params}`);
+    // Patched (DiagnoLeads #236): parameter values can hold personal data, so keep them out of
