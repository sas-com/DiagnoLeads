# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnoleads_dev"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Email (Optional - for production)
RESEND_API_KEY=""

# AI (Optional - for AI features)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Jobs (Optional - for background jobs)
TRIGGER_API_KEY=""
TRIGGER_API_URL="https://api.trigger.dev"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DiagnoLeads"

# Public Diagnostic Form (Optional)
# If not set, a "Public Leads" organization will be created automatically
DEFAULT_ORGANIZATION_ID=""

# AX migration diagnosis (/ax-diagnosis)
# Organization that receives the leads (falls back to DEFAULT_ORGANIZATION_ID)
AX_DIAGNOSIS_ORGANIZATION_ID=
# Comma-separated sales addresses notified on consultation requests (requires RESEND_API_KEY)
AX_DIAGNOSIS_SALES_EMAIL=
# Comma-separated addresses told by email about server errors (lib/ops/alert.ts), at most one
# alert per place every 10 minutes. Falls back to AX_DIAGNOSIS_SALES_EMAIL. Requires RESEND_API_KEY
OPS_ALERT_EMAIL=
# Privacy policy linked from the diagnosis form (shown only when set)
NEXT_PUBLIC_AX_PRIVACY_POLICY_URL=
# GA4 measurement ID ("G-…") for the AX migration site; off when empty. Mention the analytics
# (cookies) in the privacy policy before setting it. Also widens the CSP connect-src for GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console: the content value of the HTML tag (google-site-verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Cloudflare Turnstile bot check on the diagnosis form (on only when both are set).
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CMS (PayloadCMS 3.91)
CMS_PROVIDER="payload"  # Options: mock, payload, sanity
CMS_ENABLED=""  # true / false. Empty: off in production, on elsewhere (#141)
CRON_SECRET=""  # Vercel Cron sends it as a Bearer token (/api/cron/*)
PAYLOAD_SECRET="your-payload-secret-here-change-in-production"
# Payload uses the main DATABASE_URL with a separate 'cms' schema
# true: sync the cms schema to the collections in dev (ALTERs the DB). Set it only
# against a local DB, e.g. for the first setup or after changing collections (#235)
PAYLOAD_PUSH=""

# Email (Resend) - Phase 5.2
# RESEND_API_KEY already defined above
EMAIL_FROM="DiagnoLeads <noreply@diagnoleads.com>"

# Slack Integration - Phase 5.3
# Configure webhook URLs per organization in the dashboard

# Zapier/Make Integration - Phase 5.4
ZAPIER_API_KEY=""  # Optional: For Zapier app authentication

# CMS Webhook Integration
CMS_SLACK_WEBHOOK_URL=""  # Optional: Slack notifications for CMS changes
CMS_ZAPIER_WEBHOOK_URL=""  # Optional: Zapier webhook for CMS events
CMS_ZAPIER_WEBHOOK_SECRET=""  # Optional: Webhook signature secret
CMS_WEBHOOK_URL=""  # Optional: Generic webhook endpoint
CMS_WEBHOOK_SECRET=""  # Optional: Generic webhook secret

# Figma Integration
FIGMA_ACCESS_TOKEN=""  # Optional: For Figma API integration
FIGMA_WEBHOOK_SECRET=""  # Optional: For verifying Figma webhook signatures
FIGMA_AUTO_SYNC="false"  # Optional: Auto-sync content on Figma file updates

# Test mode (internal testing): limit email recipients, invitations and sign-ups to company
# addresses. "true" turns it on; domains are comma-separated (default sas-com.com).
# The addresses entered in the public diagnosis (AX migration) and the embedded lead form are
# restricted too: other addresses are rejected with a message, and the public pages show a
# test mode banner.
APP_TEST_MODE=""
APP_TEST_MODE_EMAIL_DOMAINS=""

# Public embed API (/api/embed/v1): off unless "true". It creates leads without the Turnstile
# check, so open it only once that check is in place (2026-10-21)
EMBED_API_ENABLED=""
