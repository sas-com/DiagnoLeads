{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run test:run)",
      "Bash(bun run test:run *)",
      "Bash(bun run test:fast)",
      "Bash(bun run test:components)",
      "Bash(bun run test:features)",
      "Bash(bun run test:lib)",
      "Bash(bun run test:coverage)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run build)",
      "Bash(bun run i18n:check)",
      "Bash(bun run i18n:check-hardcoded)",
      "Bash(bun run memory:index)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bunx vitest run *)",
      "Bash(bunx vitest --run *)",
      "Bash(bunx biome check *)",
      "Bash(bunx biome format *)",
      "Bash(git fetch *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": ["Bash(bun run db*)", "Bash(bun run test:e2e*)", "Bash(bunx drizzle-kit *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.ts",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-guard.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-decisions.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
