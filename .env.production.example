# ===========================================
# DiagnoLeads v2 Production Environment
# ===========================================
# Copy this file to .env.production.local for local testing
# Set these values in Vercel Environment Variables for production

# ===========================================
# Database (Required)
# ===========================================
# Use Vercel Postgres, Supabase, or Neon
DATABASE_URL="postgresql://user:password@host:5432/diagnoleads_prod?sslmode=require"

# ===========================================
# Authentication (Required)
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-secure-secret-min-32-chars"
BETTER_AUTH_URL="https://app.diagnoleads.com"

# ===========================================
# Application (Required)
# ===========================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://app.diagnoleads.com"
NEXT_PUBLIC_APP_NAME="DiagnoLeads"

# ===========================================
# AI Features (Optional)
# ===========================================
# Anthropic Claude API for lead scoring and chat
ANTHROPIC_API_KEY=""

# OpenAI API for embeddings (text-embedding-3-small)
OPENAI_API_KEY=""

# ===========================================
# Email - Resend (Required for production)
# ===========================================
RESEND_API_KEY=""
EMAIL_FROM="DiagnoLeads <noreply@diagnoleads.com>"

# ===========================================
# CMS (Optional)
# ===========================================
# No default: generate one with `openssl rand -base64 32` (at least 32 characters). Required
# when the CMS is on; the app refuses example values (#413)
PAYLOAD_SECRET=""
PAYLOAD_DATABASE_URL=""  # Optional: Separate DB for PayloadCMS

# ===========================================
# Background Jobs - Trigger.dev (Optional)
# ===========================================
TRIGGER_API_KEY=""
TRIGGER_API_URL="https://api.trigger.dev"

# ===========================================
# External Integrations (Optional)
# ===========================================
# Zapier App Authentication
ZAPIER_API_KEY=""

# ===========================================
# Monitoring - Sentry (Recommended)
# ===========================================
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ===========================================
# Analytics (Optional)
# ===========================================
# Vercel Analytics (auto-enabled on Vercel)
# Google Analytics
NEXT_PUBLIC_GA_ID=""

# ===========================================
# Rate Limiting (Optional)
# ===========================================
# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
